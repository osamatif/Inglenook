/// Secrets configuration template
/// Copy this file to secrets.dart and fill in your actual values
/// NEVER commit secrets.dart to git!

class Secrets {
  // Firebase Cloud Messaging
  static const String fcmServerKey = 'YOUR_FCM_SERVER_KEY';

  // Notifications API (should be backend endpoint)
  static const String notificationsApi = 'https://your-backend-url.com/api/v1/notifications';

  // IMPORTANT: Payment processing should NEVER be done client-side
  // These values are for backend use only
  // The app should only communicate with your secure backend API
  static const String paymentApiUrl = 'https://your-backend-url.com/api/v1/payments';

  // Stripe configuration (for backend reference)
  // DO NOT include secret keys here - only publishable keys
  static const String stripePublishableKey = 'pk_test_YOUR_PUBLISHABLE_KEY';
  static const String stripeMerchantId = 'YOUR_MERCHANT_ID';

  // Social Auth Keys
  static const String facebookAppId = 'YOUR_FACEBOOK_APP_ID';
  static const String googleClientId = 'YOUR_GOOGLE_CLIENT_ID';
  static const String appleClientId = 'YOUR_APPLE_CLIENT_ID';

  // Sentry/Error Reporting DSN
  static const String sentryDsn = 'YOUR_SENTRY_DSN';

  // Analytics keys
  static const String analyticsKey = 'YOUR_ANALYTICS_KEY';

  // Google Maps API Key (if using)
  static const String googleMapsApiKey = 'YOUR_GOOGLE_MAPS_API_KEY';
}
