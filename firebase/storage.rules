rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
             firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)) &&
             firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    function isValidImageSize() {
      return request.resource.size < 5 * 1024 * 1024; // 5MB limit
    }

    function isValidImageType() {
      return request.resource.contentType.matches('image/.*');
    }

    // User profile images
    match /user_profiles/{userId}/{fileName} {
      allow read: if true; // Public read
      allow write: if isOwner(userId) &&
                      isValidImageSize() &&
                      isValidImageType();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Delivery person profile images
    match /delivery_profiles/{deliveryId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if (isOwner(deliveryId) || isAdmin()) &&
                      isValidImageSize() &&
                      isValidImageType();
      allow delete: if isAdmin();
    }

    // Product images
    match /products/{productId}/{fileName} {
      allow read: if true; // Public read for product images
      allow write: if isAdmin() &&
                      isValidImageSize() &&
                      isValidImageType();
      allow delete: if isAdmin();
    }

    // Category images
    match /category_images/{categoryId}/{fileName} {
      allow read: if true; // Public read
      allow write: if isAdmin() &&
                      isValidImageSize() &&
                      isValidImageType();
      allow delete: if isAdmin();
    }

    // Profile images (legacy path)
    match /profile_images/{userId}/{fileName} {
      allow read: if true;
      allow write: if isOwner(userId) &&
                      isValidImageSize() &&
                      isValidImageType();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Product images (legacy path)
    match /product_images/{productId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin() &&
                      isValidImageSize() &&
                      isValidImageType();
      allow delete: if isAdmin();
    }

    // Order receipts/documents (admin and order owner only)
    match /order_documents/{orderId}/{fileName} {
      allow read: if isAdmin() ||
                     isOwner(firestore.get(/databases/(default)/documents/orders/$(orderId)).data.userId);
      allow write: if isAdmin();
      allow delete: if isAdmin();
    }

    // Temporary uploads (24 hour TTL, authenticated users)
    match /temp/{userId}/{fileName} {
      allow read, write: if isOwner(userId) &&
                            isValidImageSize() &&
                            isValidImageType();
      allow delete: if isOwner(userId);
    }

    // Admin uploads
    match /admin_uploads/{fileName} {
      allow read: if isSignedIn();
      allow write, delete: if isAdmin();
    }

    // Default deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
