/// Secrets configuration template
/// Copy this file to secrets.dart and fill in your actual values
/// NEVER commit secrets.dart to git!

class Secrets {
  // Firebase Cloud Messaging
  static const String fcmServerKey = 'YOUR_FCM_SERVER_KEY';

  // Notifications API
  static const String notificationsApi = 'YOUR_NOTIFICATIONS_API_URL';

  // Admin credentials (for development only)
  // In production, use Firebase Authentication properly
  static const String devAdminEmail = 'admin@example.com';
  static const String devAdminPassword = 'CHANGE_ME_IN_PRODUCTION';

  // API Keys (if needed for admin operations)
  static const String adminApiKey = 'YOUR_ADMIN_API_KEY';

  // Sentry/Error Reporting DSN (if using)
  static const String sentryDsn = 'YOUR_SENTRY_DSN';

  // Analytics keys (if using third-party analytics)
  static const String analyticsKey = 'YOUR_ANALYTICS_KEY';
}
